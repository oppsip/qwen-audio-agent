[Unit]
Description=Qwen Audio Agent Gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/qwen-audio-agent/repo
ExecStart=%h/.local/opt/node-v22.22.2/bin/node cli/bin/qwenaudio.mjs gateway run --url http://127.0.0.1:18888
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=default.target
